# Copy to .env for local development. On Render these are set in the dashboard
# (render.yaml generates JWT_SECRET for you).
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string

# Admin account, created on first start if it does not exist yet.
ADMIN_EMAIL=admin@trickorcommit.test
ADMIN_PASSWORD=spooky-admin-2026

# --- Payments ---------------------------------------------------------------
# SMEPay (UPI checkout widget) is used when its keys are set.
# Get them at app.smepay.in -> Integrations -> View API docs.
# SMEPAY_ENV=test uses staging.smepay.in; live (extranet.smepay.in) is refused
# unless ALLOW_LIVE_PAYMENTS=true.
SMEPAY_CLIENT_ID=
SMEPAY_CLIENT_SECRET=
SMEPAY_ENV=test
# Public URL of this site, for SMEPay's redirect + webhook (defaults to the request host).
# PUBLIC_URL=https://your-service.onrender.com
# Force a gateway: smepay | razorpay | demo (default: first one with keys, else demo)
# PAYMENT_PROVIDER=

# Razorpay TEST keys (optional alternative). rzp_live_ keys are refused unless
# ALLOW_LIVE_PAYMENTS=true. With no gateway keys at all, a demo gateway is used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# SQLite file (defaults to backend/data/store.db)
# DB_FILE=

# AutoFix (AI ticket triage + auto-fix). When both are set, every new
# "Report a problem" ticket is forwarded there and AutoFix posts progress back.
# AUTOFIX_URL=https://your-autofix-tunnel.example.com
# AUTOFIX_SECRET=same-value-as-autofix/.env
# Max tickets per device per 10 minutes (spam guard)
# TICKET_RATE_LIMIT=5
