# Copy to .env and fill in.

# Long random string, shared with VictoryPath (backend/.env AUTOFIX_SECRET and
# the GitHub repo secret AUTOFIX_SECRET).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUTOFIX_SECRET=

# VictoryPath backend, for posting progress onto bug reports
VICTORYPATH_API_URL=https://victorypath.kletech.ac.in
# Browser origins allowed to call the API directly (bug reports normally arrive
# server-to-server from the VictoryPath backend, so this rarely matters)
ALLOWED_ORIGINS=https://victorypath.kletech.ac.in

# Gemma: hosted through the Gemini API (Google AI Studio key)
GEMMA_PROVIDER=google
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
MIN_CONFIDENCE=0.75
# Or free Gemma through OpenRouter (key from openrouter.ai/keys):
# GEMMA_PROVIDER=openai
# GEMMA_BASE_URL=https://openrouter.ai/api/v1
# GEMMA_MODEL=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free
# Or a local/remote Ollama server instead:
# GEMMA_PROVIDER=ollama
# OLLAMA_URL=http://localhost:11434
# GEMMA_MODEL=gemma4:26b

# Claude worker. VICTORYPATH_REPO_DIR must be a DEDICATED clone: the worker
# hard-resets it before every ticket. Run `npm ci` in its frontend/ once.
WORKER_ENABLED=true
VICTORYPATH_REPO_DIR=C:/autofix-work/VictoryPath
# Production is the branch ci-cd.yml deploys from
GIT_BRANCH=Production
# main = push straight to GIT_BRANCH (CI still gates the deploy); branch = push to ai/<id>
PUSH_MODE=main
GIT_AUTHOR_NAME=AutoFix Bot
GIT_AUTHOR_EMAIL=autofix-bot@users.noreply.github.com

# Same checks as the frontend CI job; Claude must pass them and the worker re-runs them
BUILD_CMD=npm --prefix frontend run build
TEST_CMD=npm --prefix frontend run lint

CLAUDE_MODEL=sonnet
CLAUDE_TIMEOUT=600
CLAUDE_MAX_BUDGET_USD=1.00
MAX_ATTEMPTS=2

# Guardrails: path prefixes, comma-separated
ALLOWED_PATHS=frontend/src/
PROTECTED_PATHS=.github/,.env,CLAUDE.md,backend/,deploy/,frontend/src/context/AuthContext.jsx,frontend/src/pages/Login.jsx,frontend/src/components/ForcedPasswordGate.jsx,frontend/src/constants/roles.js,frontend/src/api/client.js
MAX_CHANGED_FILES=5
MAX_DIFF_LINES=200

TICKET_PREFIX=AF
